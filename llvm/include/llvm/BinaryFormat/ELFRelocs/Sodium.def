#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

ELF_RELOC(R_SODIUM_NONE,          0)  /* No reloc */
ELF_RELOC(R_SODIUM_8,             1)
ELF_RELOC(R_SODIUM_16,            2)
ELF_RELOC(R_SODIUM_32,            3)
ELF_RELOC(R_SODIUM_BR20,          4)
ELF_RELOC(R_SODIUM_BR25,          5)
ELF_RELOC(R_SODIUM_CALL,          6)
ELF_RELOC(R_SODIUM_HI19,          7)
ELF_RELOC(R_SODIUM_PCREL_HI19,    8)
ELF_RELOC(R_SODIUM_LO13,          9)
ELF_RELOC(R_SODIUM_LO13S,         10)
ELF_RELOC(R_SODIUM_PCREL_LO13,    11)
ELF_RELOC(R_SODIUM_PCREL_LO13S,   12)
ELF_RELOC(R_SODIUM_ADD8,          13)
ELF_RELOC(R_SODIUM_ADD16,         14)
ELF_RELOC(R_SODIUM_ADD32,         15)
ELF_RELOC(R_SODIUM_SUB8,          16)
ELF_RELOC(R_SODIUM_SUB16,         17)
ELF_RELOC(R_SODIUM_SUB32,         18)
ELF_RELOC(R_SODIUM_RELAX,         19)
/* These are GNU extensions to enable C++ vtable garbage collection.  */
ELF_RELOC(R_SODIUM_GNU_VTINHERIT, 20)
ELF_RELOC(R_SODIUM_GNU_VTENTRY,   21)
