#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

ELF_RELOC(R_SODIUM_NONE,          0)  /* No reloc */
ELF_RELOC(R_SODIUM_16,            1)
ELF_RELOC(R_SODIUM_32,            2)
ELF_RELOC(R_SODIUM_BR20,          3)
ELF_RELOC(R_SODIUM_BR25,          4)
ELF_RELOC(R_SODIUM_CALL,          5)
ELF_RELOC(R_SODIUM_CALL_PLT,      6)
ELF_RELOC(R_SODIUM_HI19,          7)
ELF_RELOC(R_SODIUM_GOT_HI19,      8)
ELF_RELOC(R_SODIUM_PCREL_HI19,    9)
ELF_RELOC(R_SODIUM_LO13,          10)
ELF_RELOC(R_SODIUM_LO13S,         11)
ELF_RELOC(R_SODIUM_PCREL_LO13,    12)
ELF_RELOC(R_SODIUM_PCREL_LO13S,   13)
ELF_RELOC(R_SODIUM_ADD8,          14)
ELF_RELOC(R_SODIUM_ADD16,         15)
ELF_RELOC(R_SODIUM_ADD32,         16)
ELF_RELOC(R_SODIUM_SUB8,          17)
ELF_RELOC(R_SODIUM_SUB16,         18)
ELF_RELOC(R_SODIUM_SUB32,         19)
ELF_RELOC(R_SODIUM_RELAX,         20)
/* These are GNU extensions to enable C++ vtable garbage collection.  */
ELF_RELOC(R_SODIUM_GNU_VTINHERIT, 21)
ELF_RELOC(R_SODIUM_GNU_VTENTRY,   22)
