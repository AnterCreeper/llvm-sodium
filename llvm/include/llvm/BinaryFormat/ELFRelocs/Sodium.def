#ifndef ELF_RELOC
#error "ELF_RELOC must be defined"
#endif

ELF_RELOC(R_SODIUM_NONE,          0)  /* No reloc */
ELF_RELOC(R_SODIUM_16,            1)
ELF_RELOC(R_SODIUM_32,            2)
ELF_RELOC(R_SODIUM_ADD8,          3)
ELF_RELOC(R_SODIUM_SUB8,          4)
ELF_RELOC(R_SODIUM_ADD16,         5)
ELF_RELOC(R_SODIUM_ADD32,         6)
ELF_RELOC(R_SODIUM_SUB16,         7)
ELF_RELOC(R_SODIUM_SUB32,         8)
ELF_RELOC(R_SODIUM_BR20,          9)
ELF_RELOC(R_SODIUM_BR25,          10)
ELF_RELOC(R_SODIUM_CALL,          11)
ELF_RELOC(R_SODIUM_RELAX,         12)
ELF_RELOC(R_SODIUM_HI16,          13)
ELF_RELOC(R_SODIUM_LO16,          14)
ELF_RELOC(R_SODIUM_PCREL_ADD,     15)
ELF_RELOC(R_SODIUM_PCREL_ADD12,   16)
ELF_RELOC(R_SODIUM_PCREL_ADD20,   17)
ELF_RELOC(R_SODIUM_PCREL_LO13I,   18)
ELF_RELOC(R_SODIUM_PCREL_LO13L,   19)

/* These are GNU extensions to enable C++ vtable garbage collection.  */
ELF_RELOC(R_SODIUM_GNU_VTINHERIT, 20)
ELF_RELOC(R_SODIUM_GNU_VTENTRY,   21)
